    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Carregar dados",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 400],
      "credentials": { "postgres": { "id": "agendaPostgres01", "name": "Postgres agenda" } },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT row_to_json(c) FROM conversas c WHERE c.telefone = $1) AS conversa,\n  (SELECT coalesce(json_agg(s ORDER BY s.id), '[]') FROM servicos s WHERE s.ativo) AS servicos,\n  (SELECT coalesce(json_agg(to_char(a.inicio, 'YYYY-MM-DD\"T\"HH24:MI')), '[]')\n     FROM agendamentos a\n    WHERE a.status = 'confirmado'\n      AND a.inicio >= (now() AT TIME ZONE 'America/Boa_Vista')::date\n      AND a.inicio <  (now() AT TIME ZONE 'America/Boa_Vista')::date + 31) AS ocupados,\n  (SELECT coalesce(json_agg(to_char(b.dia, 'YYYY-MM-DD')), '[]')\n     FROM bloqueios b\n    WHERE b.dia >= (now() AT TIME ZONE 'America/Boa_Vista')::date\n      AND b.dia <  (now() AT TIME ZONE 'America/Boa_Vista')::date + 31) AS bloqueios,\n  (SELECT coalesce(json_agg(json_build_object('id', a.id, 'inicio', to_char(a.inicio, 'YYYY-MM-DD\"T\"HH24:MI'), 'servico_id', a.servico_id) ORDER BY a.inicio), '[]')\n     FROM agendamentos a\n    WHERE a.telefone = $1 AND a.status = 'confirmado'\n      AND a.inicio >= (now() AT TIME ZONE 'America/Boa_Vista')) AS meus;",
        "options": { "queryReplacement": "={{ $json.telefone }}" }
      }
    },
    {
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Motor de conversa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 400],
      "parameters": { "jsCode": "__CODE:motor.js,n8n/motor.js__" }
    },
    {
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Gravar conversa e agenda",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1100, 400],
      "credentials": { "postgres": { "id": "agendaPostgres01", "name": "Postgres agenda" } },
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (SELECT convert_from(decode($1, 'base64'), 'UTF8')::jsonb AS j),\nconv AS (\n  INSERT INTO conversas (telefone, idioma, etapa, dados, atualizado_em)\n  SELECT j->>'telefone', j->'conversa'->>'idioma', j->'conversa'->>'etapa', coalesce(j->'conversa'->'dados', '{}'::jsonb), now() FROM p\n  ON CONFLICT (telefone) DO UPDATE\n    SET idioma = EXCLUDED.idioma, etapa = EXCLUDED.etapa, dados = EXCLUDED.dados, atualizado_em = now()\n  RETURNING telefone\n),\nnovo AS (\n  INSERT INTO agendamentos (telefone, nome, servico_id, inicio, idioma)\n  SELECT j->>'telefone', j->'acao'->>'nome', (j->'acao'->>'servico_id')::int, (j->'acao'->>'inicio')::timestamp, coalesce(j->'conversa'->>'idioma', 'pt')\n    FROM p WHERE j->'acao'->>'tipo' = 'agendar'\n  ON CONFLICT (inicio) WHERE status = 'confirmado' DO NOTHING\n  RETURNING id\n),\ncancelado AS (\n  UPDATE agendamentos a SET status = 'cancelado'\n    FROM p\n   WHERE p.j->'acao'->>'tipo' = 'cancelar'\n     AND a.id = (p.j->'acao'->>'id')::int\n     AND a.telefone = p.j->>'telefone'\n  RETURNING a.id\n)\nSELECT (SELECT count(*) FROM conv) AS conversa_salva,\n       (SELECT id FROM novo) AS agendamento_id,\n       (SELECT count(*) FROM cancelado) AS cancelados;",
        "options": { "queryReplacement": "={{ $json.payload }}" }
      }
    },
    {
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Finalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 400],
      "parameters": { "jsCode": "__CODE:n8n/finalizar.js__" }
    },
    {
