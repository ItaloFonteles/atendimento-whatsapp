# Copie este arquivo para ".env" e troque as senhas/chaves.

# Banco de dados
POSTGRES_USER=agenda
POSTGRES_PASSWORD=troque-esta-senha

# Chave para acessar a Evolution API (invente uma longa)
EVOLUTION_API_KEY=troque-esta-chave
# Nome da conexão do WhatsApp na Evolution
EVOLUTION_INSTANCIA=clinica

# Chave que o n8n usa para criptografar as credenciais (invente uma longa e NÃO perca)
N8N_ENCRYPTION_KEY=troque-esta-chave-de-criptografia

# true = não envia nada pelo WhatsApp; o webhook devolve a resposta (para testar sem celular)
MODO_TESTE=true

# Número do dono que recebe o resumo diário (DDI + DDD + número, só dígitos)
DONO_TELEFONE=5595999999999
